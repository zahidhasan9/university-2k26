NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/unisphere
CLIENT_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters

# Upload provider: local or cloudinary
UPLOAD_DRIVER=local
UPLOAD_MAX_MB=5
# Required when the public backend URL differs from the request origin:
# UPLOAD_BASE_URL=http://localhost:5000

# Required only when UPLOAD_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
